{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ida-chungtu.f88.co/schemas/power-automate-email-request-v1.json",
  "title": "IDA Chung Tu - Power Automate Email Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "batch_id", "request_id", "requested_at", "source", "email_type", "campaign", "callback", "messages"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "batch_id": {"type": "string", "format": "uuid"},
    "request_id": {"type": "string", "format": "uuid"},
    "requested_at": {"type": "string", "format": "date-time"},
    "source": {"const": "ida-chungtu"},
    "email_type": {"enum": ["pgd_response", "area_monitoring", "area_confirmation", "shop_submission_receipt"]},
    "campaign": {
      "type": "object",
      "required": ["id", "code", "name", "report_month"],
      "properties": {"id": {"type": "integer"}, "code": {"type": "string"}, "name": {"type": "string"}, "report_month": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"}}
    },
    "callback": {"type": "object", "required": ["url"], "properties": {"url": {"type": "string", "format": "uri"}}},
    "messages": {
      "type": "array", "minItems": 1, "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["message_id", "idempotency_key", "target", "from", "to", "cc", "bcc", "subject", "body", "metadata"],
        "properties": {
          "message_id": {"type": "string", "format": "uuid"},
          "idempotency_key": {"type": "string"},
          "target": {"type": "object"},
          "from": {"type": "object", "required": ["address", "name"]},
          "to": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "email"}},
          "cc": {"type": "array", "items": {"type": "string", "format": "email"}},
          "bcc": {"type": "array", "items": {"type": "string", "format": "email"}},
          "subject": {"type": "string", "minLength": 1, "maxLength": 500},
          "body": {"type": "object", "required": ["content_type", "content"], "properties": {"content_type": {"const": "html"}, "content": {"type": "string"}}},
          "metadata": {"type": "object"}
        }
      }
    }
  }
}

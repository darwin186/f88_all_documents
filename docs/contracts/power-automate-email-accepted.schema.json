{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Power Automate Email Accepted Response",
  "type": "object",
  "required": ["ok", "batch_id", "request_id", "provider_batch_id", "status", "results"],
  "properties": {
    "ok": {"const": true},
    "batch_id": {"type": "string", "format": "uuid"},
    "request_id": {"type": "string", "format": "uuid"},
    "provider_batch_id": {"type": "string"},
    "status": {"const": "accepted"},
    "accepted_at": {"type": "string", "format": "date-time"},
    "results": {"type": "array", "items": {"type": "object", "required": ["message_id", "status"], "properties": {"message_id": {"type": "string", "format": "uuid"}, "status": {"enum": ["accepted", "rejected"]}}}}
  }
}
